# Copy to .env and fill in. Never commit .env.

# Kite Connect
KITE_API_KEY=
KITE_API_SECRET=

# Database (project database on rkneo50q PostgreSQL)
DB_HOST=192.168.0.250
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# MyInvestIQ data (read-only)
MYINVESTIQ_DB_NAME=portfolio_watch
# prod: /home/rakeshbk/myinvestiq/data/bhavcopy  (dev: //100.103.189.15/myinvestiq/data/bhavcopy)
BHAVCOPY_ARCHIVE_DIR=
INDEX_ARCHIVE_DIR=

# This project's data
# default <repo>/data/bhavcopy_legacy (prod uses the default)
LEGACY_BHAVCOPY_DIR=
# default <repo>/data/bhavcopy_udiff (2024-01-03..2025-08-27; prod uses the default)
