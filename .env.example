# Copy to .env and fill in. Never commit .env.

# Kite Connect (ST-006): stratrad's own Personal app; prod only. Never printed or logged.
KITE_API_KEY=
KITE_API_SECRET=
# default ~/.stratrad/kite_session.json (outside the repo and the backup mirror)
KITE_SESSION_FILE=
# default 8765 (the callback listens on 127.0.0.1 only)
KITE_CALLBACK_PORT=
# Cloudflare Access in front of the callback (not secrets; required, the callback refuses everything without them)
KITE_ACCESS_TEAM=soft-cake-51bb.cloudflareaccess.com
KITE_ACCESS_AUD=

# Database (ST-012): libpq URLs incl. passwords. Prod: localhost:5432; laptop: the dev container (docs/CONFIG.md)
STRATRAD_DB_URL=postgresql://stratrad_app:<pw>@localhost:5432/stratrad
STRATRAD_READER_URL=postgresql://stratrad_reader:<pw>@localhost:5432/stratrad
MYINVESTIQ_RO_URL=postgresql://stratrad_ro:<pw>@localhost:5432/portfolio_watch

# MyInvestIQ data (read-only)
# prod: /home/rakeshbk/myinvestiq/data/bhavcopy  (dev: //100.103.189.15/myinvestiq/data/bhavcopy)
BHAVCOPY_ARCHIVE_DIR=
INDEX_ARCHIVE_DIR=

# This project's data
# default <repo>/data/bhavcopy_legacy (prod uses the default)
LEGACY_BHAVCOPY_DIR=
# default <repo>/data/bhavcopy_udiff (2024-01-03..2025-08-27; prod uses the default)
UDIFF_GAP_DIR=
TRENDLYNE_DROP_DIR=

# Logs, default <repo>/logs (prod: readable on Windows at X:\logs)
LOG_DIR=

# Telegram approvals
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude (news risk scoring, strategy research)
ANTHROPIC_API_KEY=
